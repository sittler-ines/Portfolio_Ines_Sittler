---
// Carrousel horizontal : la liste défile au doigt ou au trackpad grâce au défilement « aimanté »
// (classes snap-x de Tailwind), même sans JavaScript. Les flèches et les points sont activés par
// src/scripts/carrousel.js.
// titre : nom du carrousel pour les lecteurs d'écran ; nombre : nombre d'éléments (pour les points).
const { titre, nombre = 0 } = Astro.props;

// Flèches rondes : crème (précédent) et moutarde (suivant), grisées au début et à la fin
const fleche = 'size-16 cursor-pointer rounded-full border-3 border-brun text-[1.6rem] font-semibold text-brun disabled:cursor-default disabled:opacity-40';
---
<div data-carrousel>
  <div class="mb-6 flex items-center justify-end gap-4" data-controles hidden>
    <button type="button" class={`${fleche} bg-creme shadow-fleche`} data-precedent aria-label="Projet précédent">←</button>
    <button type="button" class={`${fleche} bg-moutarde shadow-fleche-creme`} data-suivant aria-label="Projet suivant">→</button>
  </div>
  <!-- La piste : une colonne par carte, sans jamais couper de carte : 1 carte entière sur mobile,
       2 sur tablette, 3 sur grand écran (largeur calculée en retirant les espaces de 1,75 rem entre les cartes).
       Défilement horizontal aimanté, barre de défilement cachée, un peu de marge pour l'ombre des cartes -->
  <ul
    class="grid snap-x snap-mandatory auto-cols-[100%] grid-flow-col gap-7 overflow-x-auto pt-2 pr-4 pb-6 pl-1 scrollbar-none md:auto-cols-[calc((100%-1.75rem)/2)] lg:auto-cols-[calc((100%-3.5rem)/3)] [&::-webkit-scrollbar]:hidden [&>li]:snap-start"
    aria-label={titre} tabindex="0" data-piste
  >
    <slot />
  </ul>
  <!-- Les points : un par position possible (le script cache ceux en trop, par exemple 3 positions
       pour 5 projets quand 3 cartes sont visibles). Un clic fait défiler jusqu'à cette position ;
       le point de la position affichée devient moutarde (attribut data-actif posé par le script).
       Chaque point est un bouton de 24 px (assez grand pour le doigt) avec un rond de 14 px dedans. -->
  <div class="mt-8 flex gap-1" data-points hidden>
    {Array.from({ length: nombre }, (_, i) => (
      <button type="button" class="group grid size-6 cursor-pointer place-items-center" aria-label={`Aller à la position ${i + 1}`} data-point>
        <span class="size-3.5 rounded-full border-2 border-creme group-data-actif:border-moutarde group-data-actif:bg-moutarde"></span>
      </button>
    ))}
  </div>
</div>
<script>
  import '../scripts/carrousel.js';
</script>
