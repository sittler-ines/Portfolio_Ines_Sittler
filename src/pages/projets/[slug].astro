---
import { carte, carteBandeau, conteneur, haut, leadHaut, lien, lienHaut, script, texteRiche, titreEcho, titreSection } from '../../styles/classes.js';
// Page d'un projet : l'étude de cas (contexte, rôle, processus, choix techniques, résultat).
// Chaque partie s'affiche seulement si elle est remplie dans PocketBase.
// Peu de cartes : l'étude de cas est écrite directement sur le fond, et une seule fiche « En bref »
// regroupe les infos, les outils et les qualités.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Vague from '../../components/Vague.astro';
import FormeLave from '../../components/FormeLave.astro';
import Bouton from '../../components/Bouton.astro';
import Competence from '../../components/Competence.astro';
import Qualites from '../../components/Qualites.astro';
import Galerie from '../../components/Galerie.astro';
import { getProjet, getProjets } from '../../lib/pocketbase.js';

const projet = await getProjet(Astro.params.slug);
if (!projet) return Astro.rewrite('/404');

// Projet suivant (on revient au premier après le dernier)
const tous = await getProjets();
const index = tous.findIndex((p) => p.slug === projet.slug);
const suivant = tous.length > 1 ? tous[(index + 1) % tous.length] : null;

// Les 5 parties de l'étude de cas
const parties = [
  // Un projet perso n'a pas de commande : le titre devient simplement « Le contexte »
  { titre: projet.type === 'perso' ? 'Le contexte' : 'Le contexte et la commande', html: projet.contexte },
  { titre: 'Mon rôle', html: projet.monRole },
  { titre: 'Mon processus', html: projet.processus },
  { titre: 'Mes choix techniques', html: projet.technique },
  { titre: 'Le résultat', html: projet.resultat },
].filter((p) => p.html);

const fiche = [
  ['Type', projet.type === 'perso' ? 'Projet personnel' : 'Projet de BUT MMI'],
  ['Année', projet.annee],
  ['Équipe', projet.equipe],
  ["Ce que j'ai fait", projet.role],
  // Les outils en texte, seulement si aucun outil n'est coché (sinon ils s'affichent avec leur logo)
  ['Outils', projet.outilsLies.length ? '' : projet.outils.join(', ')],
].filter(([, valeur]) => valeur);

// Vidéo : YouTube et Vimeo intégrés sans cookies de suivi, sinon un simple lien
// url : l'adresse de la vidéo saisie dans PocketBase (texte)
function lireVideo(url: string) {
  if (!url) return null;
  try {
    const u = new URL(url);
    const hote = u.hostname.replace(/^www\./, '');
    if (hote === 'youtube.com' && u.searchParams.get('v')) return { iframe: `https://www.youtube-nocookie.com/embed/${u.searchParams.get('v')}` };
    if (hote === 'youtu.be') return { iframe: `https://www.youtube-nocookie.com/embed${u.pathname}` };
    if (hote === 'vimeo.com') return { iframe: `https://player.vimeo.com/video${u.pathname}?dnt=1` };
  } catch {}
  return { lien: url };
}
const video = lireVideo(projet.video);
---

<BaseLayout titre={projet.titre} description={projet.resume || `Le projet ${projet.titre}, par Inès Sittler.`} image={projet.couverture ?? undefined}>
  <section class={`${haut}`} aria-labelledby="titre-projet">
    <FormeLave forme="haute" couleur="moutarde" class="absolute -right-16 -top-16 w-36 md:-right-20 md:w-96" />
    <!-- Haut de la page : le titre et le résumé à gauche, le mockup (ou la capture) à droite -->
    <div class={`${conteneur} relative grid items-center gap-10 pb-10 pt-2 md:pb-14 lg:grid-cols-[1fr_1.1fr]`}>
      <div>
        <a href="/projets" class={`${lienHaut} inline-flex min-h-11 items-center`}><span aria-hidden="true">←&nbsp;</span>Tous les projets</a>
        <h1 id="titre-projet" class={`${titreEcho} text-titre mt-2`}>{projet.titre}</h1>
        {projet.resume && <p class={`${leadHaut} mt-6 max-w-[48ch]`}>{projet.resume}</p>}
      </div>
      <!-- Le mockup (ou la capture) : le navigateur choisit la largeur adaptée à l'écran (srcset).
           Le cadre 16/10 réserve la place avant le chargement, pour que la page ne saute pas. -->
      {projet.imageHaut && (
        <img src={projet.imageHaut.src} srcset={projet.imageHaut.srcset}
          sizes="(min-width: 1024px) 50vw, 100vw" width="1200" height="750"
          alt={`Aperçu du projet ${projet.titre}`} fetchpriority="high"
          class="relative aspect-16/10 h-auto w-full object-contain" />
      )}
    </div>
    <Vague />
  </section>

  <div class={`${conteneur} pt-14`}>
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_360px]">
      <!-- L'étude de cas : texte directement sur le fond brun, un trait moutarde entre les parties -->
      <div>
        {parties.map((p, i) => (
          <section class:list={['py-8', i > 0 && 'border-t-2 border-moutarde/40', i === 0 && 'pt-0']}>
            <h2 class={`${script} text-[clamp(2.4rem,4vw,3.2rem)] text-moutarde`}>{p.titre}</h2>
            <div class={`${texteRiche} mt-4 max-w-[68ch] text-lg/relaxed`} set:html={p.html} />
          </section>
        ))}
      </div>

      <!-- La fiche du projet -->
      <aside class={`${carte} lg:sticky lg:top-6`} aria-labelledby="titre-fiche">
        <h2 id="titre-fiche" class={`${carteBandeau} bg-rouge text-creme`}>En bref</h2>
        <dl class="px-6 py-4">
          {fiche.map(([nom, valeur]) => (
            <div class="border-b-2 border-brun/15 py-3 last:border-0">
              <dt class="font-semibold italic">{nom}</dt>
              <dd class="mt-1">{valeur}</dd>
            </div>
          ))}
        </dl>
        {projet.outilsLies.length > 0 && (
          <div class="border-t-2 border-brun/15 px-6 py-4">
            <h3 class="mb-3 font-semibold italic">Outils utilisés</h3>
            <ul class="grid grid-cols-3 gap-2">
              {projet.outilsLies.map((c: any) => <li><Competence {...c} /></li>)}
            </ul>
          </div>
        )}
        {projet.qualites.length > 0 && (
          <div class="border-t-2 border-brun/15 px-6 py-4">
            <h3 class="mb-3 font-semibold italic">Ce que ce projet montre de moi</h3>
            <Qualites qualites={projet.qualites} petit />
          </div>
        )}
        {projet.lien && <p class="border-t-2 border-brun/15 px-6 py-4"><a href={projet.lien} target="_blank" rel="noopener" class={`${lien}`}>{projet.lien.includes('figma.com') ? 'Voir le prototype Figma' : 'Voir le site en ligne'}</a></p>}
      </aside>
    </div>


    {video && (
      <section class="mt-16" aria-labelledby="titre-video">
        <h2 id="titre-video" class={`${titreSection} text-moutarde`}>En vidéo</h2>
        <div class={`${carte} mt-8`}>
          {video.iframe
            ? <iframe src={video.iframe} title={`Vidéo du projet ${projet.titre}`} class="aspect-video w-full" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen />
            : <p class="p-6"><a href={video.lien} class={`${lien}`}>Voir la vidéo</a></p>}
        </div>
      </section>
    )}

    {projet.galerie.length > 0 && (
      <section class="mt-16" aria-labelledby="titre-images">
        <h2 id="titre-images" class={`${titreSection} text-moutarde`}>En images</h2>
        <div class="mt-8"><Galerie images={projet.galerie} titre={projet.titre} /></div>
      </section>
    )}

    {suivant && (
      <nav aria-label="Projet suivant" class="mt-20 flex justify-end">
        <a href={`/projets/${suivant.slug}`} class="group block text-right no-underline">
          <span class="block font-semibold italic">Projet suivant <span aria-hidden="true">→</span></span>
          <span class={`${script} mt-1 block text-5xl text-moutarde group-hover:underline`}>{suivant.titre}</span>
        </a>
      </nav>
    )}
    <div class="mt-10 flex justify-center"><Bouton href="/projets" couleur="creme">Tous les projets</Bouton></div>
  </div>
</BaseLayout>
